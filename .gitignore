# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Virtual environments (root only)
/.venv/
/venv/
/env/
/ENV/

# Training outputs, checkpoints, and logs (root only)
/runs/
/checkpoints/
/logs/
*.tfevents.*

# Large data files and audio/archive files
*.tar
*.tar.gz
*.zip
*.7z
*.rar
*.wav
*.mp3
!web/audio/**
*.flac

# Generated procedural dataset and visualization outputs
/data/train/*
!/data/train/.gitkeep
/data/heldout/*
!/data/heldout/.gitkeep
/data/multikey_train/*
!/data/multikey_train/.gitkeep
/data/multikey_heldout/*
!/data/multikey_heldout/.gitkeep
/data/uploads/*
!/data/uploads/.gitkeep
/data/manifest.json
/data/manifest_multikey.json
/outputs/


# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

.agents/
instructions.md
